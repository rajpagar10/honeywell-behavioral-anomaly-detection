# Configuration sources. Paths are resolved from the project root.
BADP_CONFIG_FILE=config/development.yaml
BADP_ENV_FILE=.env

# Typed nested overrides use a double underscore.
BADP_RUNTIME__ENVIRONMENT=development
BADP_RUNTIME__DEBUG=false
BADP_API__HOST=127.0.0.1
BADP_API__PORT=8000
BADP_DATABASE__OPERATIONAL_PATH=data/runtime/behavioral_security.db
BADP_DATABASE__EVALUATION_PATH=data/evaluation/ground_truth.db
BADP_DATABASE__BUSY_TIMEOUT_MS=5000
BADP_LOGGING__LEVEL=INFO
BADP_LOGGING__FORMAT=json
BADP_RANDOMNESS__SEED=1729
BADP_RANDOMNESS__DETERMINISTIC_TORCH=true
BADP_INTELLIGENCE__MODEL_PATH=artifacts/models/fast/model.joblib
BADP_INTELLIGENCE__EVENTS_PATH=data/samples/honeywell_demo/events.csv
BADP_INTELLIGENCE__METRICS_PATH=artifacts/models/fast/metrics.json
BADP_INTELLIGENCE__ALERT_THRESHOLD=55
BADP_INTELLIGENCE__REPLAY_INTERVAL_MS=100
BADP_INVESTIGATION__PROVIDER=ollama
BADP_INVESTIGATION__MODEL=llama3.1:8b
BADP_INVESTIGATION__BASE_URL=http://127.0.0.1:11434
BADP_INVESTIGATION__TIMEOUT_SECONDS=3
BADP_INVESTIGATION__RETRY_COOLDOWN_SECONDS=30
